# OpenWA (conexão pelo WhatsApp Web, rota não oficial). Só é preciso com o perfil nao-oficial.
# Copie para <destino>/segredos/openwa.env ou para o cofre de segredos da implantação.

PORT=2785
NODE_ENV=production
# Endereço público https do OpenWA: o adaptador monta com ele o endereço que recebe os avisos do Chatwoot.
BASE_URL=https://wa.seudominio.com.br
# A chave de administrador que o servidor do projeto usa (OPENWA_API_KEY no projeto). 64 caracteres aleatórios.
API_MASTER_KEY=troque_por_64_caracteres_aleatorios

DATABASE_TYPE=sqlite
DATABASE_NAME=/app/data/openwa.sqlite
SESSION_DATA_PATH=/app/data/sessions
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/media
AUTO_START_SESSIONS=true

# whatsapp-web.js usa um Chromium por sessão (300 a 500 MB cada, menor risco segundo o OpenWA);
# baileys usa 30 a 80 MB por sessão, com risco maior de banimento.
ENGINE_TYPE=whatsapp-web.js
