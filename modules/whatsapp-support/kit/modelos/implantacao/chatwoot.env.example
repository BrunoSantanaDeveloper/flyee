# Chatwoot, Postgres e Redis. Copie para <destino>/segredos/chatwoot.env (pasta fora do git) ou para o
# cofre de segredos do caminho de implantação. Gere cada segredo com 64 caracteres aleatórios.

# Endereço público do painel, com https e domínio do projeto (subdomínio do mesmo domínio do sistema).
FRONTEND_URL=https://atendimento.seudominio.com.br
FORCE_SSL=true
SECRET_KEY_BASE=troque_por_64_caracteres_aleatorios
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false

# Banco: o Chatwoot lê POSTGRES_USERNAME; a imagem do Postgres lê POSTGRES_USER. Os dois iguais.
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_uma_senha_longa

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=troque_por_uma_senha_longa

# Arquivos enviados nas conversas. "local" guarda no volume chatwoot_storage; em produção, prefira S3 ou compatível.
ACTIVE_STORAGE_SERVICE=local

# E-mail de aviso aos atendentes (opcional). Sem SMTP, os avisos ficam só no painel e nas notificações do navegador.
MAILER_SENDER_EMAIL=Atendimento <atendimento@seudominio.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Fica desligado: o robô e o OpenWA recebem avisos por endereço público https e assinado.
# SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false
