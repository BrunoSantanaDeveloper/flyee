# Uma pilha do atendimento atrás do proxy da borda. Copie como sites/<pilha>.caddy, troque os dois domínios
# e o prefixo sistema-a pelo PILHA do .env da pilha, e recarregue o Caddy. Os nomes sistema-a-chatwoot,
# sistema-a-robo e sistema-a-openwa vêm de compose.compartilhado.yml, na rede borda-<pilha>.

atendimento.sistema-a.com.br {
	encode gzip

	# A página que cria o super administrador fica fechada para quem não está em SISTEMA_A_INSTALACAO_IPS: quem chegar
	# primeiro vira super administrador, e o domínio novo aparece nos registros públicos de certificados.
	@instalacao {
		path /installation /installation/*
		not remote_ip {$SISTEMA_A_INSTALACAO_IPS:127.0.0.1/32}
	}
	handle @instalacao {
		respond 404
	}

	# O robô recebe os avisos do Chatwoot em https://<domínio do atendimento>/robo/chatwoot.
	handle_path /robo/* {
		reverse_proxy sistema-a-robo:8080
	}

	handle {
		reverse_proxy sistema-a-chatwoot:3000 {
			# Modo moldura (o painel dentro do sistema): tire o comentário das duas linhas abaixo e ponha a
			# origem do sistema. O Chatwoot manda X-Frame-Options SAMEORIGIN; trocamos por frame-ancestors.
			# header_down -X-Frame-Options
			# header_down Content-Security-Policy "frame-ancestors 'self' https://app.sistema-a.com.br"
		}
	}
}

# Só com a conexão pelo WhatsApp Web. Só a API (protegida pela chave) e os avisos assinados do Chatwoot;
# o painel do OpenWA não fica exposto.
wa.sistema-a.com.br {
	@api path /api/*
	handle @api {
		reverse_proxy sistema-a-openwa:2785
	}
	handle {
		respond 404
	}
}
