{
  "name": "flyee",
  "version": "1.1.0",
  "description": "A CLI do flyee.club: instala e mantém atualizados os apps do clube na IA que você já usa (Claude Code, Codex, Gemini CLI, Cursor e outras).",
  "keywords": ["flyee", "claude-code", "codex", "gemini-cli", "cursor", "agent-skills", "ai-apps"],
  "homepage": "https://flyee.club",
  "license": "MIT",
  "author": "flyee.club",
  "type": "module",
  "bin": {
    "flyee": "dist/flyee.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-core.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "fflate": "^0.8.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
