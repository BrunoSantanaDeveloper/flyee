# Robô de atendimento. Copie para <destino>/segredos/robo.env ou para o cofre de segredos da implantação.

PORT=8080
# O robô chama a API do Chatwoot pela rede interna dos contêineres.
CHATWOOT_URL=http://chatwoot-rails:3000
# A base das rotas que o projeto expõe para o robô (config, tools, history), com https.
PROJECT_URL=https://app.seudominio.com.br/api/atendimento/robo
# O mesmo valor de SUPPORT_BOT_SECRET no servidor do projeto: 64 caracteres aleatórios.
SUPPORT_BOT_SECRET=troque_por_64_caracteres_aleatorios

# Chaves dos provedores de IA que as contas usam. Só os nomes terminados em _API_KEY são lidos.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Serviços compatíveis com a OpenAI usam o nome que a configuração da conta indicar em ai.key_env, por exemplo:
# OPENROUTER_API_KEY=

# Imagem, áudio e vídeo (o ffmpeg vem no Dockerfile do robô). A transcrição usa a chave do Gemini, que custa
# menos, ou a da OpenAI; sem nenhuma das duas, áudio vai para a equipe. Os modelos podem ser trocados aqui.
# MEDIA_GEMINI_MODEL=gemini-3.1-flash-lite
# MEDIA_OPENAI_MODEL=gpt-4o-mini-transcribe
# Tamanho máximo de um anexo, em MB, e minutos de fala transcritos por áudio ou vídeo.
# MEDIA_MAX_MB=100
# MEDIA_MAX_MINUTES=30
# Mídias processadas ao mesmo tempo no contêiner.
# MEDIA_CONCURRENCY=2

# Espera para juntar mensagens seguidas do cliente, em milissegundos.
DEBOUNCE_MS=2500
# Por quanto tempo o perfil de quem escreve (rota contact do projeto) vale numa conversa, em milissegundos.
# PROFILE_TTL_MS=300000
