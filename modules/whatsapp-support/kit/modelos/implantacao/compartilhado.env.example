# Servidor com mais de um sistema: copie para .env nesta pasta (ao lado de compose.yml), uma vez por pilha.
# O Docker Compose lê este arquivo sozinho: ele escolhe os dois arquivos, o nome do projeto e os perfis.

# Nome curto da pilha, em letras minúsculas, números e hífen, diferente em cada sistema do servidor.
PILHA=sistema-a

# O mesmo nome no projeto do Compose: sem ele, duas pilhas dividiriam contêineres e volumes, banco incluído.
COMPOSE_PROJECT_NAME=atendimento-sistema-a

# Os dois arquivos, nesta ordem. Separador de Linux; no Windows, use ponto e vírgula.
COMPOSE_FILE=compose.yml:compose.compartilhado.yml

# Com a conexão pelo WhatsApp Web, ligue o OpenWA. Pela API oficial, apague a linha.
COMPOSE_PROFILES=nao-oficial

# Tetos de memória e CPU desta pilha (regra de bolso para duas pilhas numa VPS de 16 GB). Some os tetos de
# todas as pilhas e deixe pelo menos 1 GB para o sistema e o proxy. O OpenWA pede de 300 a 500 MB por número.
LIMITE_CHATWOOT_RAILS=1200m
LIMITE_CHATWOOT_SIDEKIQ=1000m
LIMITE_POSTGRES=768m
LIMITE_REDIS=256m
LIMITE_ROBO=768m
LIMITE_OPENWA=3g
