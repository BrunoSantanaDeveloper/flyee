# Kit whatsapp-support: proxy de referência com TLS automático. Traefik e Nginx: veja a referência
# de arquitetura do kit, que traz as mesmas regras.

{
	email {$ACME_EMAIL}
	servers {
		# Desde a 2.11.4, o Caddy descarta cabeçalhos com sublinhado. O adaptador do OpenWA chama a API do
		# Chatwoot com o token em api_access_token: sem esta linha, ele leva 401 e a mensagem do WhatsApp nunca
		# vira conversa. É o único que precisa passar (opção da 2.11.6).
		expected_underscore_headers api_access_token
	}
}

{$CHATWOOT_HOST} {
	encode gzip

	# A página que cria o super administrador fica fechada para quem não está em INSTALACAO_IPS: quem chegar
	# primeiro vira super administrador, e o domínio novo aparece nos registros públicos de certificados.
	@instalacao {
		path /installation /installation/*
		not remote_ip {$INSTALACAO_IPS:127.0.0.1/32}
	}
	handle @instalacao {
		respond 404
	}

	# O robô recebe os avisos do Chatwoot em https://<CHATWOOT_HOST>/robo/chatwoot.
	handle_path /robo/* {
		reverse_proxy robo:8080
	}

	handle {
		reverse_proxy chatwoot-rails:3000 {
			# Modo moldura (o painel dentro do sistema): tire o comentário das duas linhas abaixo.
			# O Chatwoot manda X-Frame-Options SAMEORIGIN; trocamos por frame-ancestors com a origem do sistema.
			# header_down -X-Frame-Options
			# header_down Content-Security-Policy "frame-ancestors 'self' {$PROJECT_ORIGIN}"
		}
	}
}

{$OPENWA_HOST} {
	# Só a API (protegida pela chave) e os avisos assinados do Chatwoot. O painel do OpenWA não fica exposto.
	@api path /api/*
	handle @api {
		reverse_proxy openwa:2785
	}
	handle {
		respond 404
	}
}
