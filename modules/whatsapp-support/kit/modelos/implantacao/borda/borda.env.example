# O proxy da borda: copie para borda.env nesta pasta. O e-mail recebe os avisos do certificado TLS.

ACME_EMAIL=infra@seudominio.com.br

# Por pilha, os IPs (separados por espaço) que abrem /installation, a página que cria o super
# administrador. Sem a linha, só o próprio servidor abre. Ponha o IP de quem cria o super administrador.
SISTEMA_A_INSTALACAO_IPS=127.0.0.1/32
