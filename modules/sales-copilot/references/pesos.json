{
  "version": 1,
  "label": "Regra de bolso",
  "source": "Pesos definidos pelo app como ponto de partida, sem medição em calls reais. O sinal da call diz para que lado a conversa andou; ele não prevê venda.",
  "checked_on": "2026-11-15",
  "note": "O sinal vai de 0 a 100. A cada fala: base da etapa mais a soma dos pesos do que apareceu, e depois uma média com o valor anterior (smoothing é o peso da fala nova). Um projeto troca qualquer número copiando este arquivo para copiloto-de-vendas/pesos.json; a leitura é refeita sem perguntar nada de novo.",
  "start": 30,
  "floor": 3,
  "ceiling": 95,
  "smoothing": 0.4,
  "base_by_stage": {
    "opening": 25,
    "discovery": 30,
    "qualification": 35,
    "presentation": 35,
    "objection": 30,
    "price": 40,
    "closing": 45,
    "next_steps": 40
  },
  "weights": {
    "commitment": { "kind": "signal", "points": 16 },
    "interest": { "kind": "signal", "points": 10 },
    "agreement": { "kind": "signal", "points": 3 },
    "open_question": { "kind": "signal", "points": 3 },
    "next_step_set": { "kind": "fact", "points": 10 },
    "problem_named": { "kind": "fact", "points": 5 },
    "value_stated": { "kind": "fact", "points": 5 },
    "impact_sized": { "kind": "fact", "points": 4 },
    "money_discussed": { "kind": "fact", "points": 4 },
    "decider_known": { "kind": "fact", "points": 4 },
    "timing_known": { "kind": "fact", "points": 4 },
    "situation_known": { "kind": "fact", "points": 2 },
    "participation": { "kind": "score", "points": 8 },
    "urgency": { "kind": "score", "points": 5 },
    "tone": { "kind": "score", "points": 4 },
    "pulling_away": { "kind": "signal", "points": -15 },
    "objection_open": { "kind": "computed", "points": -14 },
    "seller_talking_too_much": { "kind": "computed", "points": -10 },
    "confusion": { "kind": "signal", "points": -5 },
    "alternative_mentioned": { "kind": "signal", "points": -4 },
    "feature_dump": { "kind": "signal", "points": -4 }
  },
  "labels": {
    "next_step_set": "Próximo passo combinado",
    "objection_open": "Objeção em aberto",
    "seller_talking_too_much": "Vendedor falando demais"
  },
  "thresholds": {
    "fact": 0.7,
    "on": 0.6,
    "objection_open": 0.6,
    "objection_clear": 0.6,
    "objection_max_age_turns": 8,
    "kind_min_confidence": 0.4,
    "move_min_confidence": 0.35,
    "talk_share_warn": 0.65,
    "talk_share_max": 0.9,
    "talk_share_min_turns": 6,
    "monologue_words": 70,
    "short_reply_words": 2,
    "window_turns": 12,
    "min_sample_calls": 10
  }
}
