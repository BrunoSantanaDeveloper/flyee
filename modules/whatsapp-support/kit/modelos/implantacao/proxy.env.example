# Caddy (perfil proxy), para servidor sem proxy próprio. Copie para <destino>/segredos/proxy.env.

ACME_EMAIL=infra@seudominio.com.br
CHATWOOT_HOST=atendimento.seudominio.com.br
OPENWA_HOST=wa.seudominio.com.br
# Origem do sistema que abre o painel dentro da moldura (modo moldura). Sem moldura, deixe como está:
# o cabeçalho que libera a moldura só entra no bloco comentado do Caddyfile.
PROJECT_ORIGIN=https://app.seudominio.com.br
# Os IPs (separados por espaço) que abrem /installation, a página que cria o super administrador. Sem a
# linha, só o próprio servidor abre. Ponha o IP de quem vai criar o super administrador e tire depois.
INSTALACAO_IPS=127.0.0.1/32
