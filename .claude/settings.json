{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(node:*)",
      "PowerShell(npm run:*)",
      "PowerShell(npm test:*)",
      "PowerShell(node:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/app-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/catalog-sync.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/harness-sync.mjs"
          }
        ]
      }
    ]
  }
}
